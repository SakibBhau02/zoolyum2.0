{
  "name": "zoolyum2.0",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "bunx --package prisma@7 -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bunx --package prisma@7 -- prisma db seed",
    "db:studio": "bunx --package prisma@7 -- prisma studio",
    "db:generate": "bunx --package prisma@7 -- prisma generate",
    "db:reset-admin": "tsx scripts/reset-admin.ts",
    "db:prune": "tsx scripts/prune.ts",
    "db:privatize-leads": "tsx scripts/privatize-leads.ts",
    "content:home-v7": "tsx scripts/migrate-home-v7.ts",
    "content:home-v8": "tsx scripts/migrate-home-v8.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "lenis": "^1.3.26",
    "next": "16.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
